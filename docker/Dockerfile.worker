# syntax=docker/dockerfile:1
#
# Dedicated ARC-20 sync/backup worker image. The final image is distroless,
# non-root, read-only-rootfs compatible, and contains no configuration or
# credential values. Runtime configuration is mounted by Compose.

########################  Stage 1: Rust build  ########################
FROM rust:1.97.1-slim-trixie@sha256:8e8cf8f7fd54a2d23d5a743b3a03f56e26b6c774276c33fa0595111704ebb15c AS rust-build
WORKDIR /build

# aws-lc (used by the maintained S3 SDK TLS stack) needs a native C/CMake
# toolchain. Build-only packages never enter the runtime image.
# DEBIAN_FRONTEND is set per-invocation rather than as an ENV so it cannot leak
# into anything built from this stage. Without it debconf probes Dialog, then
# Readline, then Teletype, fails each one for want of a tty and prints six
# warning lines before falling back to Noninteractive on its own — this simply
# tells it the answer up front. Install behaviour is unchanged.
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential cmake perl pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Both cache mounts are explicitly identified. Unnamed, a cache mount takes its
# TARGET PATH as its id, so this stage shared one `/usr/local/cargo/registry`
# and one `/build/target` with docker/Dockerfile.server, Dockerfile.hardened and
# docker/Dockerfile.search-projector. `docker compose --profile postgres
# --profile worker build` builds three of them at once, and two cargo processes
# unpacking into one registry collide on `.cargo-ok` (File exists, os error 17).
#
# The registry gets sharing=private because cargo's package cache lock lives at
# $CARGO_HOME/.package-cache — outside this mount, hence unable to arbitrate
# between stages. A private copy per build is the isolation cargo cannot supply
# itself. It was sharing=locked, which was correct but serialised every Rust
# stage in the bake: measured, running the four images concurrently instead of
# back-to-back is 1.71x, and costs only a registry copy per build. The target dir
# keeps sharing=shared
# because cargo's build directory lock (<target-dir>/.cargo-lock) IS inside the
# mount and does serialise concurrent users; its id is split per package purely
# to stop the worker and server builds invalidating each other's artefacts.
# docker/Dockerfile.server carries the full reasoning.
#
# A literal id is enough here: this Dockerfile compiles one package with one
# feature set, so there is no second variant to keep apart.
#
# `all-transports` compiles the S3, SFTP, SMB and FTPS protocol clients. They are
# OFF in chancela-worker's default features — the worker's own code is
# protocol-agnostic, and a workspace-wide `cargo check` should not pay for four
# clients it never dials — so this image asks for them explicitly. It is the
# runner: dropping them here would leave the queue accepting backup jobs the
# process cannot execute. (It would refuse them loudly rather than silently, but
# refusing is not the job.) Nothing overrides this list; keep it literal.
RUN --mount=type=cache,id=chancela-cargo-registry,sharing=private,target=/usr/local/cargo/registry \
    --mount=type=cache,id=chancela-cargo-target-worker,sharing=shared,target=/build/target \
    cargo build --release --locked -p chancela-worker \
    --features chancela-worker/all-transports \
    && cp target/release/chancela-worker /chancela-worker

########################  Stage 2: Runtime  ########################
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:d97bc0a941b8d4be647dc0ee75b264ddbb772f1ac5ba690a4309c00723b23775 AS runtime

LABEL org.opencontainers.image.title="chancela-worker" \
      org.opencontainers.image.description="Durable Chancela sync and backup worker" \
      org.opencontainers.image.source="https://github.com/supermarsx/chancela" \
      org.opencontainers.image.licenses="LicenseRef-Chancela-NonCommercial" \
      org.opencontainers.image.base.name="gcr.io/distroless/cc-debian13:nonroot" \
      org.opencontainers.image.base.digest="sha256:d97bc0a941b8d4be647dc0ee75b264ddbb772f1ac5ba690a4309c00723b23775"

COPY --from=rust-build /chancela-worker /usr/local/bin/chancela-worker
# Create the mount point without embedding a runtime configuration.
COPY --chown=nonroot:nonroot docker/.chancela-data.keep /etc/chancela-worker/.keep
# Seed the paths shared with chancela-server. The API writes only beneath
# /var/lib/chancela/worker/sources and publishes audited jobs to queue.
COPY --chown=nonroot:nonroot docker/.chancela-data.keep /var/lib/chancela/worker/sources/.keep
COPY --chown=nonroot:nonroot docker/.chancela-data.keep /var/lib/chancela/worker/targets/sync/.keep
COPY --chown=nonroot:nonroot docker/.chancela-data.keep /var/lib/chancela/worker/targets/backup/.keep
COPY --chown=nonroot:nonroot docker/.chancela-data.keep /var/lib/chancela/worker/queue/.keep

USER 65532:65532

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/chancela-worker", "healthcheck", "--data-dir", "/var/lib/chancela/worker/queue", "--max-age-seconds", "120"]

ENTRYPOINT ["/usr/local/bin/chancela-worker"]
CMD ["run", "--config", "/etc/chancela-worker/config.json", "--data-dir", "/var/lib/chancela/worker/queue"]
