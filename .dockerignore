# Build artifacts
target
**/target
# Per-executor cargo target dirs (.gitignore /target-*). These are not matched by
# the `target` rules above and are enormous: a build context measured here was
# 911 GB, which makes `docker build` transfer the context for days before the
# first instruction runs. Same rationale as the .claude entry below.
target-*
# `target-*` anchors at the context root, so a per-executor dir nested in a
# workspace member (.gitignore /apps/web/target-t91) needs its own rule.
**/target-*
# The remaining scratch roots .gitignore knows about. EVERY gitignored build
# scratch directory needs a rule here too: git status cannot show it, so nothing
# else makes it visible, and `COPY . .` in both build stages pulls it in.
# Measured on this tree: .cargo-target-lanes alone was 44 GB, which is why
# `docker compose build` sat in "transferring context" past 25 GB instead of
# reaching the first RUN. These are agent/measurement lanes and no stage reads
# them.
.cargo-target-lanes
.perf-work
Projectschancelatarget-*
Book.termo_abertura
dist
apps/web/dist
lib*.rlib
*.tar.gz
# Coverage snapshots written next to the web workspace while measuring.
apps/web/coverage-*

# Dependencies (reinstalled inside the image)
node_modules
**/node_modules

# VCS / tooling / orchestration metadata
.git
.gitignore
.gitattributes
.github
.orchestration
# Agent worktrees under .claude are full repo checkouts; without this they are
# copied into every build context (observed >1.5GB) and slow every image build.
.claude

# Runtime secrets must never enter the Docker build context.
docker/secrets
# Local environment files (.gitignore .env / .env.*) can hold credentials. Both
# build stages run `COPY . .`, so an operator's .env would otherwise be baked
# into a build layer. .env.example is excluded too: no stage reads it.
.env
.env.*

# Desktop shell is not part of the server or web image
apps/desktop

# Misc
*.log
.DS_Store
